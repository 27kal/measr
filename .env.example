# Browser configuration. Vite exposes only VITE_-prefixed values to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local Supabase CLI and management-script configuration. These values are
# developer credentials and must never use the VITE_ prefix.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Edge Function secrets. Set these in the deployed Supabase project; keeping
# them here is useful only for local function serving and development scripts.
COMPANIES_HOUSE_API_KEY=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8766/oauth/callback
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6
OPENAI_STATEMENT_MODEL=
AGENT_RUNNER_SECRET=
APP_ORIGIN=http://127.0.0.1:8765

# Guarded Xero recovery experiment inputs. The failure-injection token is
# intentionally not persisted here; generate and unset it for each run.
EXPERIMENT_USER_EMAIL=
EXPERIMENT_COMPANY_NUMBER=

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically by the Supabase Edge Function runtime and do not belong here.
